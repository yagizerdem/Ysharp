

YPF.draculaMode();
YPF.invokeLater(()=> do
    const f = new YPF.Frame();
    f.setVisible(true);
    f.setSize(500, 400);

    var b = new YPF.Button();
    f.add(b);

    f.setTitle("test");

    var a = f.getTitle();

    println " a : " + a;

    println "state : " + f.getExtendedState();

    f.setResizable(false);
    f.setLayout(null);
    b.setBounds(50, 50, 120, 40);
    b.setText("yagiz erdem");

end);

println Random.nextInt(0, 88);