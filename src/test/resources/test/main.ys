

YPF.draculaMode();
YPF.invokeLater(()=> do
    const f = new YPF.Frame();
    f.setVisible(true);
    f.setSize(500, 400);

    var b = new YPF.Button();

    f.setTitle("test");

    var a = f.getTitle();

    println " a : " + a;

    println "state : " + f.getExtendedState();

    f.setResizable(false);
    f.setLayout(null);
    b.setBounds(50, 50, 120, 40);
    b.setText("yagiz erdem");

    var l = new YPF.Label();
    l.setBounds(100, 250, 120, 40);
    l.setText("merhaba");


    var panel = new YPF.Panel();
    panel.setSize(500, 400);
    f.add(panel);
    panel.add(b);
    panel.add(l);
    panel.setLayout(null);

    const textBox = new YPF.TextArea();
    textBox.setBounds(200, 40 , 200 ,300);
    panel.add(textBox);

end);

println Random.nextInt(0, 88);