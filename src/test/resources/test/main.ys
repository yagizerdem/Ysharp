

YPF.draculaMode();
YPF.invokeLater(()=> do

    var f = new YPF.Frame();
    f.setSize(800, 400);
    f.setLayout(new YPF.BorderLayout());
    f.setVisible(true);

    f.setDefaultCloseOperation(YPF.Frame.EXIT_ON_CLOSE);

    var list = new YPF.List();
    list.setBounds(20, 20, 200, 150);
    list.setListData(["Java", "Python", "C++"].toNativeArray());
    f.add(list);
    println list.getSelectedValue();


end);
