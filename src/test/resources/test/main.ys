
YPF.draculaMode();
YPF.invokeLater(()=> do

    var f = new YPF.Frame();
    f.setSize(800, 400);
    f.setLayout(new YPF.BorderLayout());
    f.setVisible(true);

    f.setDefaultCloseOperation(YPF.Frame.EXIT_ON_CLOSE);

    var pb = new YPF.ProgressBar();
    pb.setBounds(50, 50, 100, 10);

    pb.setMinimum(0);
    pb.setMaximum(100);
    var value = 40;
    pb.setValue(value);

    f.add(pb, YPF.BorderLayout.SOUTH);

    var t = new Thread(()=> do
        while true  do
                if(value == 100) then do break; end
                value++;
                pb.setValue(value);
                Time.sleep(10);
        end
        f.dispose();
    end);

    t.start();

end);