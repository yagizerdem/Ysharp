var terminal = new TUI.DefaultTerminal();

terminal.setCursorPosition(20, 10);
terminal.writeLine("ltj");
terminal.flush();


var size = terminal.getTerminalSize();

var listener = new TUI.SimpleTerminalResizeListener(size);

terminal.addResizeListener(listener);

listener.onResized(terminal, size);

while true do
    println listener.isTerminalResized();
    Time.sleep(1000);
end
