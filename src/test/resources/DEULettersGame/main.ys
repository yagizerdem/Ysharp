var arr = [1,2].concat([2,3,4,5]);

var s : string  = "ajf";
var ss : string = new String("hit");

s = "   " + s + " " + ss + " " + 55 + "  ";
println s;

println  s.split(" ").toString();

var a = s.split(" ").filter((x ,i ,_) => do
    if Type.getType(x) == "string" && x.trim().length() > 0 then do
        return true;
    end
    return Type.getType(x) != "string"  ? true : false ;
end);
println a.toString();

println arr.findIndex((x, i , _) => x  % 2  == 0);