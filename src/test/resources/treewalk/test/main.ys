class Range {
    var start = 0;
    var _end = 0;

    constructor(start, _end) do
        this.start = start;
        this._end = _end;
    end

    iter() do
        return new RangeIterator(this.start, this._end);
    end
}

class RangeIterator {
    var current = 0;
    var _end = 0;

    constructor(start, _end) do
        this.current = start;
        this._end = _end;
    end

    getNext() do
        if this.current > this._end then do
            return null;
        end
        var value = this.current;
        this.current++;
        return value;
    end
}

var r = new Range(1, 5);

foreach var n in r do
    println(n); // 1 2 3 4 5
end