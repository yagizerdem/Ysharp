
YPF.invokeLater(() => do
    const f = new YPF.Frame();

    f.setSize(400, 400);
    f.setVisible(true);
    f.getContentPane().
    setBackground(YPF.Color.yellow);
    var icon = YPF.Icon.createBufferedImageIcon("./circle.png");
    println icon;
    icon.setSize(40,40);

    var l = new YPF.Label();

    f.add(l);

    l.setText("test label");

    l.setIcon(icon);

end);
