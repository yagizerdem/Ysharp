var set = new Set();

// empty set
println set.isEmpty(); // true
println set.empty();   // true

// add element
set.add(10);

println set.isEmpty(); // false
println set.empty();   // false

// remove element
set.remove(10);

println set.isEmpty(); // true
println set.empty();   // true

// multiple operations
set.add(1);
set.add(2);
set.clear();

println set.isEmpty(); // true
println set.empty();   // true