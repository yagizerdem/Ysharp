
YPF.invokeLater(() => do
    var frame = new YPF.Frame();

    frame.show();
    frame.setSize(400, 400);
    frame.setLayout(new YPF.FlowLayout());

    var label = new YPF.Label();
    label.setText("test");

    const font = YPF.Font.italic("test", 10);

    println font;

    label.setFont(font);

    frame.add(label);
    frame.setDefaultCloseOperation(YPF.Frame.EXIT_ON_CLOSE);

    var c = YPF.Color.blue;

    println c;

    label.onClick(() => do
        println "lable cliecked";
    end);

end);