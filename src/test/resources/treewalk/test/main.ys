class MyObject {
    var name;
    var message;
    constructor(name : string, message : string) do
        this.name = name;
        this.message = message;
    end

    getName() do
        return this.name;
    end

    getMessage() do
        return this.message;
    end
}

var obj = new MyObject("Ali", "Hello");

println(obj.getName());    // Ali
println(obj.getMessage()); // Hello