var d = new ArrayDeque();

// empty
println d.toString(); // []

// basic usage
d.addLast(1);
d.addLast(2);
d.addLast(3);

println d.toString(); // [1, 2, 3]

// addFirst effect
d.addFirst(0);
println d.toString(); // [0, 1, 2, 3]

// after remove
d.removeLast();
println d.toString(); // [0, 1, 2]

// duplicates
d.clear();

d.addLast(7);
d.addLast(7);
d.addLast(7);

println d.toString(); // [7, 7, 7]

// mixed types
d.clear();

d.addLast(10);
d.addLast("hello");
d.addLast(true);

println d.toString(); // [10, "hello", true]

// clear
d.clear();
println d.toString(); // []