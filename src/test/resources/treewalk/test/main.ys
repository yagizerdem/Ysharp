const conn = SQLite.connect("./test.db");

println conn;
println conn.getType();

var stmt = conn.createStatement();

stmt.execute("
CREATE TABLE IF NOT EXISTS contacts (
    contact_id INTEGER PRIMARY KEY,
    first_name TEXT NOT NULL,
    last_name TEXT NOT NULL,
    email TEXT NOT NULL UNIQUE,
    phone TEXT NOT NULL UNIQUE
);
");

var ps = conn.prepareStatement("
INSERT INTO contacts (
    first_name,
    last_name,
    email,
    phone
) VALUES (?, ?, ?, ?);
");

for var i = 0; i < 100; i = i + 1 do
    ps.setString(1, "TempName" + i);
    ps.setString(2, "TempSurname" + i);
    ps.setString(3, "temp" + i + "@example.com");
    ps.setString(4, "+90555000" + i);

    ps.executeUpdate();
end

println "100 temp rows inserted";

var resultSet = stmt.executeQuery("SELECT * FROM contacts;");

println resultSet;
println resultSet.getType();

while resultSet.next() do
    var id = resultSet.getInt(1);
    var firstName = resultSet.getString(2);
    var lastName = resultSet.getString(3);
    var email = resultSet.getString(4);
    var phone = resultSet.getString(5);

    println id + " | " + firstName + " | " + lastName + " | " + email + " | " + phone;
end

resultSet.close();
ps.close();
stmt.close();
conn.close();