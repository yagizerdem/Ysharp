use "piece.ys";

export function printBoard(terminal : DefaultTerminal, board : Board) do
    for var i in 0..7 do
        for var j in 0..7 do
            var item = board.data.get(i).get(j);
            if Type.getType(item) == "Piece" then do
                if item.color == Color.BLUE then do
                    terminal.setForegroundColor(TUI.TextColor.ANSI.BRIGHT_BLUE);
                end
                elif item.color == Color.RED then do
                    terminal.setForegroundColor(TUI.TextColor.ANSI.RED);
                end
                terminal.write(" " + Type.Converter.toString(
                item.type == PieceType.KNIGHT ? "N" : PieceType.toString(item.type).toCharArray().get(0)) + " ");
                terminal.setForegroundColor(TUI.TextColor.ANSI.WHITE);
            end
            elif Type.getType(item) == "null" then do
                terminal.write(" . ");
            end
        end
        terminal.writeLine(" ".repeat(21));
        terminal.writeLine(" ".repeat(21));
    end

    terminal.flush();
end