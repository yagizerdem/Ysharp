
export class AppError {
    var reason = "";
    var code : int = 0;

    constructor() do

    end

    static create(reason) do
        var err = new AppError();
        err.reason = reason;
        return err;
    end

    static create(reason, code) do
        var err = new AppError();
        err.reason = reason;
        err.code = code;
        return err;
    end
}