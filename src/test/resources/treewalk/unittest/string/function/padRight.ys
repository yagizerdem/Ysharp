println "str.padRight test cases started";

// basic
var s1 = "a";
Assert.equals(s1.padRight(3, "0"), "a00");

// exact length (no change)
Assert.equals("abc".padRight(3, "0"), "abc");

// shorter target (should truncate from right)
Assert.equals("abcdef".padRight(3, "0"), "abc");

// multi-char pad
var s2 = "x";
Assert.equals(s2.padRight(5, "ab"), "xabab");

// pad exactly fits
Assert.equals("x".padRight(3, "yz"), "xyz");

// empty pad string (returns original)
var s3 = "test";
Assert.equals(s3.padRight(10, ""), "test");

// whitespace pad
var s4 = "hi";
Assert.equals(s4.padRight(5, " "), "hi   ");

// unicode
var s5 = "ç";
Assert.equals(s5.padRight(3, "ü"), "çüü");

// special chars
var s6 = "!";
Assert.equals(s6.padRight(4, "*"), "!***");

// chaining
var s7 = ("ab" + "cd");
Assert.equals(s7.padRight(6, "0"), "abcd00");

// immutability
var original = "abc";
var padded = original.padRight(5, "0");
Assert.equals(original, "abc");
Assert.equals(padded, "abc00");
Assert.notEquals(original, padded);

// boolean checks
Assert.isTrue("a".padRight(2, "0") == "a0");
Assert.isFalse("a".padRight(2, "0") == "0a");

// not equals
Assert.notEquals("a".padRight(3, "0"), "00a");

println "all test cases successful";