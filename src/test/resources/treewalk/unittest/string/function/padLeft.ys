println "str.padLeft test cases started";

// basic
var s1 = "a";
Assert.equals(s1.padLeft(3, "0"), "00a");

// exact length (no change)
Assert.equals("abc".padLeft(3, "0"), "abc");

// shorter target (should truncate from left)
Assert.equals("abcdef".padLeft(3, "0"), "def");

// multi-char pad
var s2 = "x";
Assert.equals(s2.padLeft(5, "ab"), "ababx");

// pad exactly fits
Assert.equals("x".padLeft(3, "yz"), "yzx");

// empty pad string (returns original)
var s3 = "test";
Assert.equals(s3.padLeft(10, ""), "test");

// whitespace pad
var s4 = "hi";
Assert.equals(s4.padLeft(5, " "), "   hi");

// unicode
var s5 = "ç";
Assert.equals(s5.padLeft(3, "ü"), "üüç");

// special chars
var s6 = "!";
Assert.equals(s6.padLeft(4, "*"), "***!");

// chaining
var s7 = ("ab" + "cd");
Assert.equals(s7.padLeft(6, "0"), "00abcd");

// immutability
var original = "abc";
var padded = original.padLeft(5, "0");
Assert.equals(original, "abc");
Assert.equals(padded, "00abc");
Assert.notEquals(original, padded);

// boolean checks
Assert.isTrue("a".padLeft(2, "0") == "0a");
Assert.isFalse("a".padLeft(2, "0") == "a0");

// not equals
Assert.notEquals("a".padLeft(3, "0"), "a00");

println "all test cases successful";