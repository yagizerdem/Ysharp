println "str.isEmpty test cases started";

// empty string
var s1 = "";
Assert.isTrue(s1.isEmpty());

// non-empty
var s2 = "a";
Assert.isFalse(s2.isEmpty());

// whitespace is NOT empty
var s3 = " ";
Assert.isFalse(s3.isEmpty());

// multiple chars
var s4 = "hello";
Assert.isFalse(s4.isEmpty());

// after trim (should be empty)
var s5 = "   ";
Assert.isTrue(s5.trim().isEmpty());

// unicode
var s6 = "ç";
Assert.isFalse(s6.isEmpty());

// special chars
var s7 = "!@#";
Assert.isFalse(s7.isEmpty());

// chaining
var s8 = ("ab" + "cd");
Assert.isFalse(s8.isEmpty());

// immutability
var original = "";
Assert.isTrue(original.isEmpty());
Assert.equals(original, "");

// boolean checks
Assert.isTrue("".isEmpty());
Assert.isFalse("x".isEmpty());

// not equals
Assert.notEquals("".isEmpty(), false);

println "all test cases successful";