println "str.endsWith test cases started";

// basic
var s1 = "hello";
Assert.isTrue(s1.endsWith("o"));
Assert.isTrue(s1.endsWith("lo"));
Assert.isFalse(s1.endsWith("l"));

// full match
Assert.isTrue(s1.endsWith("hello"));
Assert.isFalse(s1.endsWith("hello!"));

// empty search
Assert.isTrue(s1.endsWith(""));

// case sensitivity
Assert.isFalse(s1.endsWith("O"));

// longer suffix than string
Assert.isFalse("hi".endsWith("hello"));

// unicode
var s2 = "çğü";
Assert.isTrue(s2.endsWith("ü"));
Assert.isFalse(s2.endsWith("ğ"));

// special chars
var s3 = "!@#";
Assert.isTrue(s3.endsWith("@#"));
Assert.isFalse(s3.endsWith("!@"));

// whitespace
var s4 = "hello   ";
Assert.isTrue(s4.endsWith(" "));
Assert.isFalse(s4.endsWith("hello"));

// chaining
var s5 = ("ab" + "cd");
Assert.isTrue(s5.endsWith("cd"));
Assert.isFalse(s5.endsWith("bc"));

// boolean checks
Assert.isTrue("hello".endsWith("lo"));
Assert.isFalse("hello".endsWith("he"));

// not equals
Assert.notEquals("hello".endsWith("lo"), false);

// immutability
var original = "test";
Assert.isTrue(original.endsWith("st"));
Assert.equals(original, "test");

println "all test cases successful";