println "str.count test cases started";

// basic
var s1 = "hello";
Assert.equals(s1.count("l"), 2);
Assert.equals(s1.count("o"), 1);

// substring
Assert.equals(s1.count("ll"), 1);
Assert.equals(s1.count("lo"), 1);

// not found
Assert.equals(s1.count("x"), 0);

// empty needle (defined as 0 in your impl)
Assert.equals(s1.count(""), 0);

// repeated pattern (non-overlapping)
var s2 = "aaaa";
Assert.equals(s2.count("aa"), 2); // not 3 → non-overlapping

// overlapping check
Assert.equals("aaa".count("aa"), 1);

// full match
var s3 = "test";
Assert.equals(s3.count("test"), 1);

// partial match
Assert.equals(s3.count("es"), 1);

// unicode
var s4 = "çğüç";
Assert.equals(s4.count("ç"), 2);
Assert.equals(s4.count("ğ"), 1);

// special chars
var s5 = "!@#!@#";
Assert.equals(s5.count("@"), 2);

// whitespace
var s6 = "   ";
Assert.equals(s6.count(" "), 3);

// chaining
var s7 = ("ab" + "cd" + "ab");
Assert.equals(s7.count("ab"), 2);

// immutability
var original = "hello";
Assert.equals(original.count("l"), 2);
Assert.equals(original, "hello");

// boolean checks
Assert.isTrue("hello".count("l") == 2);
Assert.isFalse("hello".count("l") == 3);

// not equals
Assert.notEquals("hello".count("l"), 3);

println "all test cases successful";