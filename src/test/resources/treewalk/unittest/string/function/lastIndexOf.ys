println "str.lastIndexOf test cases started";

// basic
var s1 = "hello";
Assert.equals(s1.lastIndexOf("l"), 3);
Assert.equals(s1.lastIndexOf("o"), 4);

// substring
Assert.equals(s1.lastIndexOf("ll"), 2);
Assert.equals(s1.lastIndexOf("lo"), 3);

// not found
Assert.equals(s1.lastIndexOf("x"), -1);

// empty search (Java behavior → returns length)
Assert.equals(s1.lastIndexOf(""), 5);

// repeated pattern (should return last occurrence)
var s2 = "ababab";
Assert.equals(s2.lastIndexOf("ab"), 4);
Assert.equals(s2.lastIndexOf("ba"), 3);

// full match
var s3 = "test";
Assert.equals(s3.lastIndexOf("test"), 0);

// partial match
Assert.equals(s3.lastIndexOf("es"), 1);

// unicode
var s4 = "çğüç";
Assert.equals(s4.lastIndexOf("ç"), 3);
Assert.equals(s4.lastIndexOf("ğ"), 1);

// special chars
var s5 = "!@#!@#";
Assert.equals(s5.lastIndexOf("@"), 4);

// whitespace
var s6 = "   ";
Assert.equals(s6.lastIndexOf(" "), 2);

// chaining
var s7 = ("ab" + "cd" + "ab");
Assert.equals(s7.lastIndexOf("ab"), 4);

// boolean checks
Assert.isTrue("hello".lastIndexOf("l") == 3);
Assert.isFalse("hello".lastIndexOf("l") == 2);

// not equals
Assert.notEquals("hello".lastIndexOf("l"), 2);

println "all test cases successful";