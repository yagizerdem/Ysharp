println "str.slice test cases started";

// basic
var s1 = "hello";
Assert.equals(s1.slice(0, 2), "he");
Assert.equals(s1.slice(1, 4), "ell");

// single arg (to end)
Assert.equals(s1.slice(2), "llo");

// full range
Assert.equals(s1.slice(0, 5), "hello");

// end < start → empty
Assert.equals(s1.slice(3, 2), "");

// negative start
Assert.equals(s1.slice(-2), "lo");
Assert.equals(s1.slice(-3, -1), "ll");

// negative end
Assert.equals(s1.slice(1, -1), "ell");

// both negative
Assert.equals(s1.slice(-4, -1), "ell");

// out of bounds (clamped)
Assert.equals(s1.slice(-100, 100), "hello");
Assert.equals(s1.slice(10, 20), "");

// empty string
var s2 = "";
Assert.equals(s2.slice(0, 1), "");

// single char
var s3 = "a";
Assert.equals(s3.slice(0, 1), "a");
Assert.equals(s3.slice(1, 2), "");

// unicode
var s4 = "çğü";
Assert.equals(s4.slice(0, 2), "çğ");
Assert.equals(s4.slice(-1), "ü");

// special chars
var s5 = "!@#";
Assert.equals(s5.slice(1, 3), "@#");

// chaining
var s6 = ("ab" + "cd");
Assert.equals(s6.slice(1, 3), "bc");

// immutability
var original = "test";
var sliced = original.slice(1, 3);
Assert.equals(original, "test");
Assert.equals(sliced, "es");
Assert.notEquals(original, sliced);

// boolean checks
Assert.isTrue("hello".slice(1, 3) == "el");
Assert.isFalse("hello".slice(1, 3) == "lo");

// not equals
Assert.notEquals("hello".slice(1, 3), "lo");

println "all test cases successful";