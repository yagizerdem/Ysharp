println "str.format test cases started";

// basic string
var s1 = "Hello %s";
Assert.equals(s1.format("world"), "Hello world");

// multiple args
var s2 = "%s %s";
Assert.equals(s2.format("hello", "world"), "hello world");

// integer
var s3 = "Value: %d";
Assert.equals(s3.format(10), "Value: 10");

// multiple types
var s4 = "%s %d %b";
Assert.equals(s4.format("num:", 5, true), "num: 5 true");



// char
var s6 = "char: %c";
Assert.equals(s6.format('A'), "char: A");

// null
var s7 = "value: %s";
Assert.equals(s7.format(null), "value: null");

// mixed
var s8 = "%s-%d-%s";
Assert.equals(s8.format("id", 1, "ok"), "id-1-ok");

// no placeholders
var s9 = "hello";
Assert.equals(s9.format(), "hello");

// extra args (ignored by Java format)
var s10 = "hello %s";
Assert.equals(s10.format("world", 123), "hello world");

// chaining
var s11 = ("%s%s");
Assert.equals(s11.format("a", "b"), "ab");

// immutability
var original = "Hello %s";
var formatted = original.format("X");
Assert.equals(original, "Hello %s");
Assert.equals(formatted, "Hello X");
Assert.notEquals(original, formatted);

// boolean checks
Assert.isTrue("Hi %s".format("A") == "Hi A");
Assert.isFalse("Hi %s".format("A") == "Hi B");

// not equals
Assert.notEquals("Hi %s".format("A"), "Hi B");

println "all test cases successful";