println "str.replace test cases started";

// basic
var s1 = "hello";
Assert.equals(s1.replace("h", "y"), "yello");

// replace multiple occurrences
var s2 = "ababab";
Assert.equals(s2.replace("ab", "x"), "xxx");

// no match
Assert.equals(s1.replace("z", "x"), "hello");

// replace with longer string
Assert.equals("abc".replace("b", "XYZ"), "aXYZc");

// replace with empty string (delete)
Assert.equals("abcabc".replace("a", ""), "bcbc");

// replace whole string
Assert.equals("test".replace("test", "ok"), "ok");

// replace empty target (Java behavior: inserts between chars + ends)
Assert.equals("ab".replace("", "-"), "-a-b-");

// unicode
var s3 = "çğüç";
Assert.equals(s3.replace("ç", "x"), "xğüx");

// special chars
var s4 = "!@#!@#";
Assert.equals(s4.replace("@", "*"), "!*#!*#");

// whitespace
var s5 = "a b c";
Assert.equals(s5.replace(" ", "-"), "a-b-c");

// chaining
var s6 = ("ab" + "cd" + "ab");
Assert.equals(s6.replace("ab", "x"), "xcdx");

// immutability
var original = "hello";
var replaced = original.replace("l", "x");
Assert.equals(original, "hello");
Assert.equals(replaced, "hexxo");
Assert.notEquals(original, replaced);

// boolean checks
Assert.isTrue("hello".replace("h", "y") == "yello");
Assert.isFalse("hello".replace("h", "y") == "hello");

// not equals
Assert.notEquals("hello".replace("h", "y"), "hello");

println "all test cases successful";