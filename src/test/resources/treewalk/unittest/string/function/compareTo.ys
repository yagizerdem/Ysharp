println "str.compareTo test cases started";

// equal strings
Assert.equals("abc".compareTo("abc"), 0);

// less than
Assert.isTrue("abc".compareTo("bcd") < 0);
Assert.isTrue("a".compareTo("b") < 0);

// greater than
Assert.isTrue("bcd".compareTo("abc") > 0);
Assert.isTrue("z".compareTo("a") > 0);

// prefix cases
Assert.isTrue("ab".compareTo("abc") < 0);
Assert.isTrue("abc".compareTo("ab") > 0);

// case sensitivity (ASCII)
Assert.isTrue("a".compareTo("A") > 0);
Assert.isFalse("A".compareTo("a") > 0);

// empty strings
Assert.equals("".compareTo(""), 0);
Assert.isTrue("".compareTo("a") < 0);
Assert.isTrue("a".compareTo("") > 0);

// unicode (basic ordering)
Assert.equals("ç".compareTo("ç"), 0);
Assert.isTrue("ç".compareTo("ğ") < 0 || "ç".compareTo("ğ") > 0);

// special chars
Assert.isTrue("!".compareTo("@") < 0);
Assert.isTrue("@".compareTo("!") > 0);

// whitespace
Assert.isTrue(" ".compareTo("a") < 0);

// chaining
var s = ("ab" + "cd");
Assert.equals(s.compareTo("abcd"), 0);

// immutability
var original = "test";
Assert.equals(original.compareTo("test"), 0);
Assert.equals(original, "test");

// boolean checks
Assert.isTrue("abc".compareTo("abd") < 0);
Assert.isFalse("abc".compareTo("abd") > 0);

// not equals
Assert.notEquals("abc".compareTo("abd"), 0);

println "all test cases successful";