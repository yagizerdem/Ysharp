println "str.trimRight / trimEnd test cases started";

// basic right trim
var s1 = "hello   ";
Assert.equals(s1.trimRight(), "hello");
Assert.equals(s1.trimEnd(), "hello");

// no spaces
var s2 = "hello";
Assert.equals(s2.trimRight(), "hello");

// only spaces
var s3 = "     ";
Assert.equals(s3.trimRight(), "");

// left side should stay
var s4 = "   hello";
Assert.equals(s4.trimRight(), "   hello");

// mixed whitespace
var s5 = "   hello world   ";
Assert.equals(s5.trimRight(), "   hello world");

// tabs and newlines
var s6 = "hello\n\t   ";
Assert.equals(s6.trimRight(), "hello");

// unicode inside
var s7 = "çğü   ";
Assert.equals(s7.trimRight(), "çğü");

// special chars
var s8 = "!@#   ";
Assert.equals(s8.trimRight(), "!@#");

// immutability
var original = "test   ";
var trimmed = original.trimRight();
Assert.equals(original, "test   ");
Assert.equals(trimmed, "test");
Assert.notEquals(original, trimmed);

// alias check
var s9 = "abc   ";
Assert.equals(s9.trimEnd(), "abc");
Assert.equals(s9.trimRight(), s9.trimEnd());

// chaining
var s10 = ("ab" + "cd   ");
Assert.equals(s10.trimRight(), "abcd");

// boolean checks
Assert.isTrue("hello   ".trimRight() == "hello");
Assert.isFalse("hello   ".trimRight() == "hello   ");

// not equals
Assert.notEquals("hello   ".trimRight(), "hello   ");

println "all test cases successful";