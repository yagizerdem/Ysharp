println "str.join test cases started";

// basic
var sep = ",";
var arr1 = ["a", "b", "c"];
Assert.equals(sep.join(arr1), "a,b,c");

// single element
var arr2 = ["x"];
Assert.equals(sep.join(arr2), "x");

// empty array
var arr3 = [];
Assert.equals(sep.join(arr3), "");

// different separator
var sep2 = "-";
Assert.equals(sep2.join(["a", "b", "c"]), "a-b-c");

// whitespace separator
var sep3 = " ";
Assert.equals(sep3.join(["hello", "world"]), "hello world");

// multi-char separator
var sep4 = "--";
Assert.equals(sep4.join(["a", "b", "c"]), "a--b--c");

// unicode
var sep5 = "ç";
Assert.equals(sep5.join(["a", "b", "c"]), "açbçc");

// special chars
var sep6 = "!@";
Assert.equals(sep6.join(["x", "y"]), "x!@y");

// numbers (toString conversion)
var arr4 = [1, 2, 3];
Assert.equals(",".join(arr4), "1,2,3");

// mixed types
var arr5 = ["a", 1, true];
Assert.equals(",".join(arr5), "a,1,true");

// chaining
var arr6 = ("a,b,c".split(","));
Assert.equals("-".join(arr6), "a-b-c");

// immutability
var originalSep = ",";
var originalArr = ["a", "b"];
var joined = originalSep.join(originalArr);
Assert.equals(originalSep, ",");
Assert.equals(joined, "a,b");

// boolean checks
Assert.isTrue(",".join(["a", "b"]) == "a,b");
Assert.isFalse(",".join(["a", "b"]) == "ab");

// not equals
Assert.notEquals(",".join(["a", "b"]), "ab");

println "all test cases successful";