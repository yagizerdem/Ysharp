println "str.matches test cases started";

// exact match
Assert.isTrue("abc".matches("abc"));
Assert.isFalse("abc".matches("ab"));

// full match required (IMPORTANT)
Assert.isFalse("abc123".matches("\\d+"));
Assert.isTrue("123".matches("\\d+"));

// basic regex
Assert.isTrue("abc123".matches("[a-z]+\\d+"));
Assert.isFalse("abc123".matches("[a-z]+"));

// wildcard
Assert.isTrue("abc".matches(".*"));
Assert.isTrue("".matches(".*"));

// dot
Assert.isTrue("a".matches("."));
Assert.isFalse("ab".matches("."));

// whitespace
Assert.isTrue("   ".matches("\\s+"));
Assert.isFalse("a b".matches("\\s+"));

// unicode
Assert.isTrue("ç".matches("."));
Assert.isTrue("çğü".matches("..."));

// special chars (escaped)
Assert.isTrue("a.b".matches("a\\.b"));
Assert.isFalse("a-b".matches("a\\.b"));

// start/end anchors
Assert.isTrue("abc".matches("^abc$"));
Assert.isFalse("xabc".matches("^abc$"));

// digits
Assert.isTrue("12345".matches("\\d+"));
Assert.isFalse("123a".matches("\\d+"));

// chaining
var s = ("ab" + "cd");
Assert.isTrue(s.matches("abcd"));

// boolean checks
Assert.isTrue("hello".matches("h.*o"));
Assert.isFalse("hello".matches("h.*a"));

// not equals
Assert.notEquals("abc".matches("abc"), false);

println "all test cases successful";