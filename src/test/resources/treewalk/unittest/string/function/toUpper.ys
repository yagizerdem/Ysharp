println "str.toUpper test cases started";

var s1 = "hello";
Assert.equals(s1.toUpper(), "HELLO");

var s2 = "";
Assert.equals(s2.toUpper(), "");

var s3 = "a";
Assert.equals(s3.toUpper(), "A");

var s4 = "abc123";
Assert.equals(s4.toUpper(), "ABC123");

var s5 = "Hello World";
Assert.equals(s5.toUpper(), "HELLO WORLD");

var s6 = "!@#";
Assert.equals(s6.toUpper(), "!@#");

var s7 = "çğü";
Assert.equals(s7.toUpper(), "ÇĞÜ");

var s8 = "AbC";
Assert.equals(s8.toUpper(), "ABC");

Assert.notEquals("abc".toUpper(), "abc");

Assert.isTrue("abc".toUpper() == "ABC");
Assert.isFalse("abc".toUpper() == "abc");

var original = "test";
var upper = original.toUpper();
Assert.equals(original, "test");
Assert.equals(upper, "TEST");
Assert.notEquals(original, upper);

var chained = ("ab" + "cd").toUpper();
Assert.equals(chained, "ABCD");

println "all test cases successful";