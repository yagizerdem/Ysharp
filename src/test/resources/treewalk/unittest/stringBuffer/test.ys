println "StringBuffer test cases started";


var sb1 = new StringBuffer();
sb1.append("hello");
Assert.equals(sb1.toString(), "hello");

// chaining
var sb2 = new StringBuffer();
sb2.append("a").append("b").append("c");
Assert.equals(sb2.toString(), "abc");

// append number
var sb3 = new StringBuffer();
sb3.append(123);
Assert.equals(sb3.toString(), "123.0");

// append boolean
var sb4 = new StringBuffer();
sb4.append(true);
Assert.equals(sb4.toString(), "true");

// append char
var sb5 = new StringBuffer();
sb5.append('A');
Assert.equals(sb5.toString(), "A");

// append null
var sb6 = new StringBuffer();
sb6.append(null);
Assert.equals(sb6.toString(), "null");

// mixed append
var sb7 = new StringBuffer();
sb7.append("val=").append(10).append(", ok=").append(false);
Assert.equals(sb7.toString(), "val=10.0, ok=false");


var sb8 = new StringBuffer();
sb8.appendLine("a");
sb8.appendLine("b");
Assert.equals(sb8.toString(), "a\nb\n");

// appendLine null
var sb9 = new StringBuffer();
sb9.appendLine(null);
Assert.equals(sb9.toString(), "null\n");

// empty string
var sb10 = new StringBuffer();
sb10.appendLine("");
Assert.equals(sb10.toString(), "\n");


var sb11 = new StringBuffer();
sb11.append("abc");
sb11.insert(1, "X");
Assert.equals(sb11.toString(), "aXbc");

// insert number
var sb12 = new StringBuffer();
sb12.append("value=");
sb12.insert(6, 123);
Assert.equals(sb12.toString(), "value=123");

// insert boolean
var sb13 = new StringBuffer();
sb13.append("flag:");
sb13.insert(5, true);
Assert.equals(sb13.toString(), "flag:true");

// insert null
var sb14 = new StringBuffer();
sb14.append("abc");
sb14.insert(1, null);
Assert.equals(sb14.toString(), "anullbc");

// insert char array
var sb15 = new StringBuffer();
sb15.append("abc");
sb15.insert(1, ['x','y','z']);
Assert.equals(sb15.toString(), "axyzbc");

// insert char array with offset
var sb16 = new StringBuffer();
sb16.append("abc");
sb16.insert(1, ['a','b','c','d'], 1, 2);
Assert.equals(sb16.toString(), "abcbc");


var sb17 = new StringBuffer();
sb17.append("hello");
sb17.clear();
Assert.equals(sb17.toString(), "");

// clear reuse
var sb18 = new StringBuffer();
sb18.append("abc");
sb18.clear().append("x");
Assert.equals(sb18.toString(), "x");


var sb19 = new StringBuffer();
Assert.equals(sb19.length(), 0);

var sb20 = new StringBuffer();
sb20.append("abc");
Assert.equals(sb20.length(), 3);

var sb21 = new StringBuffer();
sb21.appendLine("a");
Assert.equals(sb21.length(), 2); // "a\n"

// after insert
var sb22 = new StringBuffer();
sb22.append("abc");
sb22.insert(1, "XYZ");
Assert.equals(sb22.length(), 6);


// invalid index
var sb23 = new StringBuffer();
sb23.append("abc");
try do
    sb23.insert(10, "x");
    Assert.fail("Expected index error");
end
catch(e) do
    Assert.isTrue(true);
end

// non-char array
var sb24 = new StringBuffer();
try do
    sb24.insert(1, [1,2,3]);
    Assert.fail("Expected char array error");
end
catch(e) do
    Assert.isTrue(true);
end

println "all StringBuffer tests successful";