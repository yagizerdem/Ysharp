println "str.substring test cases started";

// basic
var s1 = "hello";
Assert.equals(s1.substring(0, 2), "he");
Assert.equals(s1.substring(1, 4), "ell");
Assert.equals(s1.substring(0, 5), "hello");

// empty result
Assert.equals(s1.substring(2, 2), "");

// full string
var s2 = "abc";
Assert.equals(s2.substring(0, 3), "abc");

// middle slice
var s3 = "abcdef";
Assert.equals(s3.substring(2, 5), "cde");

// numeric string
var s4 = "12345";
Assert.equals(s4.substring(1, 4), "234");

// whitespace
var s5 = "   ";
Assert.equals(s5.substring(0, 2), "  ");

// special chars
var s6 = "!@#$%";
Assert.equals(s6.substring(1, 4), "@#$");

// unicode
var s7 = "çğü";
Assert.equals(s7.substring(0, 2), "çğ");

// not equals
Assert.notEquals("hello".substring(0, 2), "hi");

// boolean checks
Assert.isTrue("abcdef".substring(0, 3) == "abc");
Assert.isFalse("abcdef".substring(0, 3) == "abd");

// immutability
var original = "test";
var sub = original.substring(1, 3);
Assert.equals(original, "test");
Assert.equals(sub, "es");
Assert.notEquals(original, sub);

// chaining
var s8 = ("ab" + "cd" + "ef");
Assert.equals(s8.substring(2, 5), "cde");

println "all test cases successful";