d.addLast(5);
d.addLast(5);
d.addLast(5);

Assert.equals(d.size(), 3);

Assert.equals(d.removeLast(), 5);
Assert.equals(d.removeLast(), 5);
Assert.equals(d.removeLast(), 5);

Assert.isTrue(d.isEmpty());

// -------------------- MIXED TYPES --------------------
d.addLast(10);
d.addLast("hello");
d.addLast(true);

Assert.equals(d.size(), 3);
Assert.equals(d.peekFirst(), 10);
Assert.equals(d.peekLast(), true);

// -------------------- AFTER CLEAR --------------------
d.clear();
Assert.isTrue(d.isEmpty());

d.addLast(100);
Assert.equals(d.peekLast(), 100);

println "-".repeat(50);

println "removeFirst test";

var d = new ArrayDeque();

// -------------------- EMPTY THROW --------------------
try do
    d.removeFirst();
    Assert.fail("removeFirst on empty should throw");
end
catch(e) do
    Assert.isTrue(true);
end

// -------------------- SINGLE ELEMENT --------------------
d.addLast(10);

Assert.equals(d.removeFirst(), 10);
Assert.isTrue(d.isEmpty());

// -------------------- MULTIPLE ELEMENTS --------------------
d.addLast(1);
d.addLast(2);
d.addLast(3);

Assert.equals(d.removeFirst(), 1);
Assert.equals(d.peekFirst(), 2);
Assert.equals(d.size(), 2);

// -------------------- ORDER CHECK --------------------
Assert.equals(d.removeFirst(), 2);
Assert.equals(d.removeFirst(), 3);

Assert.isTrue(d.isEmpty());

// -------------------- MIX WITH addFirst --------------------
d.addFirst(10);
d.addFirst(20);
d.addLast(30);

Assert.equals(d.removeFirst(), 20);
Assert.equals(d.removeFirst(), 10);
Assert.equals(d.removeFirst(), 30);

Assert.isTrue(d.isEmpty());

// -------------------- DUPLICATE VALUES --------------------
d.addLast(5);
d.addLast(5);
d.addLast(5);

Assert.equals(d.removeFirst(), 5);
Assert.equals(d.removeFirst(), 5);
Assert.equals(d.removeFirst(), 5);

Assert.isTrue(d.isEmpty());

// -------------------- MIXED TYPES --------------------
d.addLast(10);
d.addLast("hello");
d.addLast(true);

Assert.equals(d.removeFirst(), 10);
Assert.equals(d.removeFirst(), "hello");
Assert.equals(d.removeFirst(), true);

Assert.isTrue(d.isEmpty());

println "-".repeat(50);

println "removeLast test";

var d = new ArrayDeque();

// -------------------- EMPTY THROW --------------------
try do
    d.removeLast();
    Assert.fail("removeLast on empty should throw");
end
catch(e) do
    Assert.isTrue(true);
end

// -------------------- SINGLE ELEMENT --------------------
d.addLast(10);

Assert.equals(d.removeLast(), 10);
Assert.isTrue(d.isEmpty());

// -------------------- MULTIPLE ELEMENTS --------------------
d.addLast(1);
d.addLast(2);
d.addLast(3);

Assert.equals(d.removeLast(), 3);
Assert.equals(d.peekLast(), 2);
Assert.equals(d.size(), 2);

// -------------------- ORDER CHECK --------------------
Assert.equals(d.removeLast(), 2);
Assert.equals(d.removeLast(), 1);

Assert.isTrue(d.isEmpty());

// -------------------- MIX WITH addFirst --------------------
d.addFirst(10);
d.addFirst(20);
d.addLast(30);

Assert.equals(d.removeLast(), 30);
Assert.equals(d.removeLast(), 10);
Assert.equals(d.removeLast(), 20);

Assert.isTrue(d.isEmpty());

// -------------------- DUPLICATE VALUES --------------------
d.addLast(5);
d.addLast(5);
d.addLast(5);

Assert.equals(d.removeLast(), 5);
Assert.equals(d.removeLast(), 5);
Assert.equals(d.removeLast(), 5);

Assert.isTrue(d.isEmpty());

// -------------------- MIXED TYPES --------------------
d.addLast(10);
d.addLast("hello");
d.addLast(true);

Assert.equals(d.removeLast(), true);
Assert.equals(d.removeLast(), "hello");
