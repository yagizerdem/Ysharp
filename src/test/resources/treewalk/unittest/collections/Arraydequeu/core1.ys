Assert.isTrue(d.isEmpty());

println "-".repeat(50);


println "peekFirst test";

var d = new ArrayDeque();

// -------------------- EMPTY THROW --------------------
try do
    d.peekFirst();
    Assert.fail("peekFirst on empty should throw");
end
catch(e) do
    Assert.isTrue(true);
end

// -------------------- SINGLE ELEMENT --------------------
d.addLast(10);

Assert.equals(d.peekFirst(), 10);
Assert.equals(d.size(), 1);

// -------------------- MULTIPLE ELEMENTS --------------------
d.addLast(20);
d.addLast(30);

Assert.equals(d.peekFirst(), 10);
Assert.equals(d.size(), 3);

// -------------------- ORDER CHECK --------------------
Assert.equals(d.removeFirst(), 10);
Assert.equals(d.peekFirst(), 20);
Assert.equals(d.size(), 2);

// -------------------- MIX WITH addFirst --------------------
d.addFirst(5);
d.addFirst(1);

Assert.equals(d.peekFirst(), 1);
Assert.equals(d.size(), 4);

// -------------------- DUPLICATE VALUES --------------------
d.clear();

d.addLast(5);
d.addLast(5);
d.addLast(5);

Assert.equals(d.peekFirst(), 5);
Assert.equals(d.size(), 3);

// -------------------- MIXED TYPES --------------------
d.clear();

d.addLast(10);
d.addLast("hello");
d.addLast(true);

Assert.equals(d.peekFirst(), 10);
Assert.equals(d.size(), 3);

// -------------------- NO REMOVE EFFECT --------------------
var first = d.peekFirst();
Assert.equals(first, 10);
Assert.equals(d.size(), 3);

println "-".repeat(50);

println "peekLast test";

var d = new ArrayDeque();

// -------------------- EMPTY THROW --------------------
try do
    d.peekLast();
    Assert.fail("peekLast on empty should throw");
end
catch(e) do
    Assert.isTrue(true);
end

// -------------------- SINGLE ELEMENT --------------------
d.addLast(10);

Assert.equals(d.peekLast(), 10);
Assert.equals(d.size(), 1);

// -------------------- MULTIPLE ELEMENTS --------------------
d.addLast(20);
d.addLast(30);

Assert.equals(d.peekLast(), 30);
Assert.equals(d.size(), 3);

// -------------------- ORDER CHECK --------------------
Assert.equals(d.removeLast(), 30);
Assert.equals(d.peekLast(), 20);
Assert.equals(d.size(), 2);

// -------------------- MIX WITH addFirst --------------------
d.addFirst(5);
d.addFirst(1);

Assert.equals(d.peekLast(), 20);
Assert.equals(d.size(), 4);

// -------------------- DUPLICATE VALUES --------------------
d.clear();

d.addLast(5);
d.addLast(5);
d.addLast(5);

Assert.equals(d.peekLast(), 5);
Assert.equals(d.size(), 3);

// -------------------- MIXED TYPES --------------------
d.clear();

d.addLast(10);
d.addLast("hello");
d.addLast(true);

Assert.equals(d.peekLast(), true);
Assert.equals(d.size(), 3);

// -------------------- NO REMOVE EFFECT --------------------
var last = d.peekLast();
Assert.equals(last, true);
Assert.equals(d.size(), 3);

println "-".repeat(50);


println "contains test";

var d = new ArrayDeque();

// -------------------- EMPTY --------------------
Assert.isTrue(!d.contains(10));

// -------------------- SINGLE ELEMENT --------------------
d.addLast(10);

Assert.isTrue(d.contains(10));
Assert.isTrue(!d.contains(20));

// -------------------- MULTIPLE ELEMENTS --------------------
d.addLast(20);
d.addLast(30);

Assert.isTrue(d.contains(10));
Assert.isTrue(d.contains(20));
Assert.isTrue(d.contains(30));
Assert.isTrue(!d.contains(999));

// -------------------- ORDER IRRELEVANT --------------------
Assert.isTrue(d.contains(10));
Assert.isTrue(d.contains(30));

// -------------------- AFTER REMOVE --------------------
d.removeFirst(); // removes 10

Assert.isTrue(!d.contains(10));
Assert.isTrue(d.contains(20));
Assert.isTrue(d.contains(30));

// -------------------- DUPLICATE VALUES --------------------
d.clear();

d.addLast(5);
d.addLast(5);
d.addLast(5);

Assert.isTrue(d.contains(5));

d.removeFirst(); // still exists
Assert.isTrue(d.contains(5));

d.removeFirst();
d.removeFirst();

Assert.isTrue(!d.contains(5));

// -------------------- MIXED TYPES --------------------
d.addLast(10);
d.addLast("hello");
d.addLast(true);

Assert.isTrue(d.contains(10));
Assert.isTrue(d.contains("hello"));
Assert.isTrue(d.contains(true));
Assert.isTrue(!d.contains(false));

// -------------------- NO SIDE EFFECT --------------------
var beforeSize = d.size();

d.contains(10);

Assert.equals(d.size(), beforeSize);

println "-".repeat(50);

println "removeFirstOccurrence test";

var d = new ArrayDeque();

// -------------------- EMPTY --------------------
Assert.isTrue(!d.removeFirstOccurrence(10));

// -------------------- SINGLE ELEMENT --------------------
d.addLast(10);

Assert.isTrue(d.removeFirstOccurrence(10));
Assert.isTrue(d.isEmpty());

// -------------------- NOT FOUND --------------------
d.addLast(1);
d.addLast(2);
d.addLast(3);

Assert.isTrue(!d.removeFirstOccurrence(999));
Assert.equals(d.size(), 3);

// -------------------- MULTIPLE ELEMENTS --------------------
d.clear();

d.addLast(1);
d.addLast(2);
d.addLast(3);
d.addLast(2);
d.addLast(4);

// remove first occurrence of 2
Assert.isTrue(d.removeFirstOccurrence(2));

Assert.equals(d.size(), 4);
Assert.equals(d.removeFirst(), 1);
Assert.equals(d.removeFirst(), 3);
Assert.equals(d.removeFirst(), 2);
Assert.equals(d.removeFirst(), 4);

Assert.isTrue(d.isEmpty());

// -------------------- REMOVE HEAD --------------------
d.addLast(5);
d.addLast(6);
d.addLast(7);

Assert.isTrue(d.removeFirstOccurrence(5));

Assert.equals(d.peekFirst(), 6);
Assert.equals(d.size(), 2);

// -------------------- REMOVE TAIL --------------------
Assert.isTrue(d.removeFirstOccurrence(7));

Assert.equals(d.peekLast(), 6);
Assert.equals(d.size(), 1);

// -------------------- DUPLICATES --------------------
d.clear();

d.addLast(9);
d.addLast(9);
d.addLast(9);

Assert.isTrue(d.removeFirstOccurrence(9));

Assert.equals(d.size(), 2);
Assert.equals(d.removeFirst(), 9);
Assert.equals(d.removeFirst(), 9);

Assert.isTrue(d.isEmpty());

// -------------------- MIXED TYPES --------------------
d.addLast(10);
d.addLast("hello");
d.addLast(true);

Assert.isTrue(d.removeFirstOccurrence("hello"));
Assert.isTrue(!d.contains("hello"));
Assert.equals(d.size(), 2);

// -------------------- NO SIDE EFFECT WHEN NOT FOUND --------------------
var beforeSize = d.size();

Assert.isTrue(!d.removeFirstOccurrence("world"));
Assert.equals(d.size(), beforeSize);

println "-".repeat(50);

println "removeLastOccurrence test";

var d = new ArrayDeque();

// -------------------- EMPTY --------------------
Assert.isTrue(!d.removeLastOccurrence(10));

// -------------------- SINGLE ELEMENT --------------------
d.addLast(10);

Assert.isTrue(d.removeLastOccurrence(10));
Assert.isTrue(d.isEmpty());

// -------------------- NOT FOUND --------------------
d.addLast(1);
d.addLast(2);
d.addLast(3);

Assert.isTrue(!d.removeLastOccurrence(999));
Assert.equals(d.size(), 3);

// -------------------- MULTIPLE ELEMENTS --------------------
d.clear();

d.addLast(1);
d.addLast(2);
d.addLast(3);
d.addLast(2);
d.addLast(4);

// remove last occurrence of 2
Assert.isTrue(d.removeLastOccurrence(2));

Assert.equals(d.size(), 4);
Assert.equals(d.removeFirst(), 1);
Assert.equals(d.removeFirst(), 2);
Assert.equals(d.removeFirst(), 3);
Assert.equals(d.removeFirst(), 4);

Assert.isTrue(d.isEmpty());

// -------------------- REMOVE TAIL --------------------
d.addLast(5);
d.addLast(6);
d.addLast(7);

Assert.isTrue(d.removeLastOccurrence(7));

Assert.equals(d.peekLast(), 6);
Assert.equals(d.size(), 2);

// -------------------- REMOVE HEAD --------------------
Assert.isTrue(d.removeLastOccurrence(5));

Assert.equals(d.peekFirst(), 6);
Assert.equals(d.size(), 1);

// -------------------- DUPLICATES --------------------
d.clear();

d.addLast(9);
d.addLast(9);
d.addLast(9);

Assert.isTrue(d.removeLastOccurrence(9));

Assert.equals(d.size(), 2);
Assert.equals(d.removeLast(), 9);
Assert.equals(d.removeLast(), 9);

Assert.isTrue(d.isEmpty());

// -------------------- MIXED TYPES --------------------
d.addLast(10);
d.addLast("hello");
d.addLast(true);

Assert.isTrue(d.removeLastOccurrence("hello"));
Assert.isTrue(!d.contains("hello"));
Assert.equals(d.size(), 2);

// -------------------- NO SIDE EFFECT WHEN NOT FOUND --------------------
var beforeSize = d.size();

Assert.isTrue(!d.removeLastOccurrence("world"));
Assert.equals(d.size(), beforeSize);

println "-".repeat(50);


println "size test";

var d = new ArrayDeque();

// -------------------- INITIAL --------------------
Assert.equals(d.size(), 0);

// -------------------- AFTER ADD --------------------
d.addLast(10);
Assert.equals(d.size(), 1);

d.addFirst(20);
Assert.equals(d.size(), 2);

d.addLast(30);
Assert.equals(d.size(), 3);

// -------------------- AFTER REMOVE --------------------
d.removeFirst();
Assert.equals(d.size(), 2);

d.removeLast();
Assert.equals(d.size(), 1);

// -------------------- DUPLICATES --------------------
d.clear();

d.addLast(5);
d.addLast(5);
d.addLast(5);

Assert.equals(d.size(), 3);

// -------------------- MIXED TYPES --------------------
d.clear();

d.addLast(10);
d.addLast("hello");
d.addLast(true);

Assert.equals(d.size(), 3);

// -------------------- CLEAR --------------------
d.clear();
Assert.equals(d.size(), 0);

// -------------------- NO SIDE EFFECT --------------------
var before = d.size();
d.size();
Assert.equals(d.size(), before);

println "-".repeat(50);

println "isEmpty test";

var d = new ArrayDeque();

// -------------------- INITIAL --------------------
Assert.isTrue(d.isEmpty());

// -------------------- AFTER ADD --------------------
d.addLast(10);
Assert.isTrue(!d.isEmpty());

// -------------------- AFTER REMOVE --------------------
d.removeFirst();
Assert.isTrue(d.isEmpty());

// -------------------- MULTIPLE OPERATIONS --------------------
d.addLast(1);
d.addLast(2);
d.addFirst(3);

Assert.isTrue(!d.isEmpty());

d.removeFirst();
d.removeLast();
d.removeFirst();

Assert.isTrue(d.isEmpty());

// -------------------- CLEAR --------------------
d.addLast(100);
d.addLast(200);

d.clear();
Assert.isTrue(d.isEmpty());

// -------------------- NO SIDE EFFECT --------------------
var before = d.isEmpty();
d.isEmpty();
Assert.equals(d.isEmpty(), before);

println "-".repeat(50);

println "clear test";

var d = new ArrayDeque();

// -------------------- INITIAL --------------------
d.clear();
Assert.isTrue(d.isEmpty());
Assert.equals(d.size(), 0);

// -------------------- AFTER ADD --------------------
d.addLast(10);
d.addLast(20);
d.addFirst(5);

Assert.equals(d.size(), 3);

// clear
d.clear();

Assert.isTrue(d.isEmpty());
Assert.equals(d.size(), 0);

// -------------------- REUSE AFTER CLEAR --------------------
d.addLast(100);
Assert.equals(d.size(), 1);
Assert.equals(d.peekFirst(), 100);

// -------------------- MULTIPLE CLEARS --------------------
d.clear();
d.clear();

Assert.isTrue(d.isEmpty());
Assert.equals(d.size(), 0);

// -------------------- MIXED TYPES --------------------
d.addLast(10);
d.addLast("hello");
d.addLast(true);

Assert.equals(d.size(), 3);

d.clear();

Assert.isTrue(d.isEmpty());
Assert.equals(d.size(), 0);

// -------------------- NO SIDE EFFECT --------------------
var before = d.size();
d.clear();
Assert.equals(d.size(), before);

println "-".repeat(50);

println "toArray test";

var d = new ArrayDeque();

// -------------------- EMPTY --------------------
var arr = d.toArray();

Assert.equals(arr.size(), 0);

// -------------------- BASIC ORDER --------------------
d.addLast(1);
d.addLast(2);
d.addLast(3);

var arr = d.toArray();

Assert.equals(arr.size(), 3);
Assert.equals(arr.get(0), 1);
Assert.equals(arr.get(1), 2);
Assert.equals(arr.get(2), 3);

// -------------------- ADD FIRST EFFECT --------------------
d.clear();

d.addLast(10);
d.addLast(20);
d.addFirst(5);

var arr = d.toArray();

Assert.equals(arr.size(), 3);
Assert.equals(arr.get(0), 5);
Assert.equals(arr.get(1), 10);
Assert.equals(arr.get(2), 20);

// -------------------- REMOVE EFFECT --------------------
d.removeFirst(); // removes 5

var arr = d.toArray();

Assert.equals(arr.size(), 2);
Assert.equals(arr.get(0), 10);
Assert.equals(arr.get(1), 20);

// -------------------- DUPLICATES --------------------
d.clear();

d.addLast(7);
d.addLast(7);
d.addLast(7);

var arr = d.toArray();

Assert.equals(arr.size(), 3);
Assert.equals(arr.get(0), 7);
Assert.equals(arr.get(1), 7);
Assert.equals(arr.get(2), 7);

// -------------------- MIXED TYPES --------------------
d.clear();

d.addLast(10);
d.addLast("hello");
d.addLast(true);

var arr = d.toArray();

Assert.equals(arr.size(), 3);
Assert.equals(arr.get(0), 10);
Assert.equals(arr.get(1), "hello");
Assert.equals(arr.get(2), true);

// -------------------- IMMUTABILITY CHECK --------------------
var arr = d.toArray();

d.addLast(999);

Assert.equals(arr.size(), 3); // should not change

// -------------------- CLEAR --------------------
d.clear();

var arr = d.toArray();

Assert.equals(arr.size(), 0);

println "-".repeat(50);

println "clone test";

var d1 = new ArrayDeque();

// -------------------- EMPTY CLONE --------------------
var d2 = d1.clone();

Assert.isTrue(d2.isEmpty());
Assert.equals(d2.size(), 0);

// -------------------- BASIC CLONE --------------------
d1.addLast(1);
d1.addLast(2);
d1.addLast(3);

var d2 = d1.clone();

Assert.equals(d1.size(), 3);
Assert.equals(d2.size(), 3);

Assert.equals(d2.peekFirst(), 1);
Assert.equals(d2.peekLast(), 3);

// -------------------- INDEPENDENCE --------------------
d1.addLast(4);

Assert.equals(d1.size(), 4);
Assert.equals(d2.size(), 3);

Assert.equals(d2.peekLast(), 3);

// -------------------- MODIFY CLONE --------------------
d2.addFirst(0);

Assert.equals(d2.peekFirst(), 0);
Assert.equals(d1.peekFirst(), 1);

// -------------------- ORDER PRESERVED --------------------
Assert.equals(d2.removeFirst(), 0);
Assert.equals(d2.removeFirst(), 1);
Assert.equals(d2.removeFirst(), 2);
Assert.equals(d2.removeFirst(), 3);

Assert.isTrue(d2.isEmpty());

// -------------------- DUPLICATES --------------------
d1.clear();

d1.addLast(5);
d1.addLast(5);
d1.addLast(5);

var d2 = d1.clone();

Assert.equals(d2.size(), 3);

Assert.equals(d2.removeFirst(), 5);
Assert.equals(d2.removeFirst(), 5);
Assert.equals(d2.removeFirst(), 5);

// -------------------- MIXED TYPES --------------------
d1.clear();

d1.addLast(10);
d1.addLast("hello");
d1.addLast(true);

var d2 = d1.clone();

Assert.equals(d2.size(), 3);
Assert.equals(d2.removeFirst(), 10);
Assert.equals(d2.removeFirst(), "hello");
Assert.equals(d2.removeFirst(), true);

Assert.isTrue(d2.isEmpty());

println "-".repeat(50);

println "toString test";

var d = new ArrayDeque();

// -------------------- EMPTY --------------------
Assert.equals(d.toString(), "[]");

// -------------------- BASIC ORDER --------------------
d.addLast(1);
d.addLast(2);
d.addLast(3);

Assert.equals(d.toString(), "[1, 2, 3]");

// -------------------- ADD FIRST EFFECT --------------------
d.clear();

d.addLast(10);
d.addLast(20);
d.addFirst(5);

Assert.equals(d.toString(), "[5, 10, 20]");

// -------------------- REMOVE EFFECT --------------------
d.removeFirst(); // removes 5

Assert.equals(d.toString(), "[10, 20]");

// -------------------- DUPLICATES --------------------
d.clear();

d.addLast(7);
d.addLast(7);
d.addLast(7);

Assert.equals(d.toString(), "[7, 7, 7]");

// -------------------- MIXED TYPES --------------------
d.clear();

d.addLast(10);
d.addLast("hello");
d.addLast(true);

Assert.equals(d.toString(), "[10, \"hello\", true]");

// -------------------- CLEAR --------------------
d.clear();

Assert.equals(d.toString(), "[]");

// -------------------- NO SIDE EFFECT --------------------
var before = d.toString();
d.toString();
Assert.equals(d.toString(), before);

println "-".repeat(50);

println "ArrayDeque test successful";