println "ArrayDeque test started";

println "empty test";

var d = new ArrayDeque();

// initial empty
Assert.isTrue(d.isEmpty());

// after add
d.addLast(10);
Assert.isTrue(!d.isEmpty());

// after remove
d.removeFirst();
Assert.isTrue(d.isEmpty());

// after clear
d.addLast(1);
d.addLast(2);
d.clear();
Assert.isTrue(d.isEmpty());

println "-".repeat(50);


println "addFirst test";

var d = new ArrayDeque();

// -------------------- INITIAL --------------------
Assert.isTrue(d.isEmpty());

d.addFirst(10);
Assert.equals(d.size(), 1);
Assert.equals(d.peekFirst(), 10);
Assert.equals(d.peekLast(), 10);

// -------------------- MULTIPLE INSERT --------------------
d.addFirst(20);
d.addFirst(30);

Assert.equals(d.size(), 3);
Assert.equals(d.peekFirst(), 30);
Assert.equals(d.peekLast(), 10);

// -------------------- ORDER CHECK --------------------
Assert.equals(d.removeFirst(), 30);
Assert.equals(d.removeFirst(), 20);
Assert.equals(d.removeFirst(), 10);

Assert.isTrue(d.isEmpty());

// -------------------- MIX WITH addLast --------------------
d.addLast(1);
d.addFirst(2);
d.addLast(3);
d.addFirst(4);

Assert.equals(d.size(), 4);
Assert.equals(d.peekFirst(), 4);
Assert.equals(d.peekLast(), 3);

// -------------------- DUPLICATE VALUES --------------------
d.clear();

d.addFirst(5);
d.addFirst(5);
d.addFirst(5);

Assert.equals(d.size(), 3);

Assert.equals(d.removeFirst(), 5);
Assert.equals(d.removeFirst(), 5);
Assert.equals(d.removeFirst(), 5);

Assert.isTrue(d.isEmpty());

// -------------------- MIXED TYPES --------------------
d.addFirst(10);
d.addFirst("hello");
d.addFirst(true);

Assert.equals(d.size(), 3);
Assert.equals(d.peekFirst(), true);
Assert.equals(d.peekLast(), 10);

// -------------------- AFTER CLEAR --------------------
d.clear();
Assert.isTrue(d.isEmpty());

d.addFirst(100);
Assert.equals(d.peekFirst(), 100);

println "-".repeat(50);

println "addLast test";

var d = new ArrayDeque();

// -------------------- INITIAL --------------------
Assert.isTrue(d.isEmpty());

d.addLast(10);
Assert.equals(d.size(), 1);
Assert.equals(d.peekFirst(), 10);
Assert.equals(d.peekLast(), 10);

// -------------------- MULTIPLE INSERT --------------------
d.addLast(20);
d.addLast(30);

Assert.equals(d.size(), 3);
Assert.equals(d.peekFirst(), 10);
Assert.equals(d.peekLast(), 30);

// -------------------- ORDER CHECK --------------------
Assert.equals(d.removeFirst(), 10);
Assert.equals(d.removeFirst(), 20);
Assert.equals(d.removeFirst(), 30);

Assert.isTrue(d.isEmpty());

// -------------------- MIX WITH addFirst --------------------
d.addFirst(1);
d.addLast(2);
d.addFirst(0);
d.addLast(3);

Assert.equals(d.size(), 4);
Assert.equals(d.peekFirst(), 0);
Assert.equals(d.peekLast(), 3);

// -------------------- DUPLICATE VALUES --------------------
