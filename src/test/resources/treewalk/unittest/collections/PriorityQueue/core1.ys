println "Priority queue core operations test started";

println "enqueue test";

var pq = new PriorityQueue();

// -------------------- INITIAL --------------------
Assert.isTrue(pq.isEmpty());

// -------------------- SINGLE INSERT --------------------
pq.enqueue(10, 5);

Assert.equals(pq.size(), 1);
Assert.equals(pq.peek(), 10);
Assert.equals(pq.peekPriority(), 5);

// -------------------- MULTIPLE INSERT --------------------
pq.enqueue(20, 3);
pq.enqueue(30, 7);

// min-heap
Assert.equals(pq.size(), 3);
Assert.equals(pq.peek(), 20);
Assert.equals(pq.peekPriority(), 3);

// -------------------- ORDER CHECK --------------------
Assert.equals(pq.dequeue(), 20);
Assert.equals(pq.dequeue(), 10);
Assert.equals(pq.dequeue(), 30);

Assert.isTrue(pq.isEmpty());

// -------------------- DUPLICATE VALUES --------------------
pq.enqueue(5, 10);
pq.enqueue(5, 1);
pq.enqueue(5, 5);

Assert.equals(pq.size(), 3);
Assert.equals(pq.dequeue(), 5); // priority 1
Assert.equals(pq.dequeue(), 5); // priority 5
Assert.equals(pq.dequeue(), 5); // priority 10

Assert.isTrue(pq.isEmpty());

// -------------------- MIXED TYPES --------------------
pq.enqueue(10, 5);
pq.enqueue("hello", 2);
pq.enqueue(true, 3);

Assert.equals(pq.peek(), "hello");
Assert.equals(pq.dequeue(), "hello");
Assert.equals(pq.dequeue(), true);
Assert.equals(pq.dequeue(), 10);

Assert.isTrue(pq.isEmpty());

// -------------------- SAME PRIORITY --------------------
pq.enqueue(1, 5);
pq.enqueue(2, 5);
pq.enqueue(3, 5);

Assert.equals(pq.size(), 3);

var a = pq.dequeue();
var b = pq.dequeue();
var c = pq.dequeue();

Assert.equals(pq.size(), 0);

Assert.isTrue(a != null);
Assert.isTrue(b != null);
Assert.isTrue(c != null);

// -------------------- NEGATIVE PRIORITY --------------------
pq.enqueue("low", 100);
pq.enqueue("high", -1);

Assert.equals(pq.peek(), "high");
Assert.equals(pq.dequeue(), "high");
Assert.equals(pq.dequeue(), "low");

Assert.isTrue(pq.isEmpty());

// -------------------- NO SIDE EFFECT --------------------
var before = pq.size();
pq.peek();
Assert.equals(pq.size(), before);

println "-".repeat(50);


println "addLast test";

var d = new ArrayDeque();

Assert.isTrue(d.isEmpty());

d.addLast(10);
Assert.equals(d.size(), 1);
Assert.equals(d.peekFirst(), 10);
Assert.equals(d.peekLast(), 10);

d.addLast(20);
d.addLast(30);

Assert.equals(d.size(), 3);
Assert.equals(d.peekFirst(), 10);
Assert.equals(d.peekLast(), 30);

Assert.equals(d.removeFirst(), 10);
Assert.equals(d.removeFirst(), 20);
Assert.equals(d.removeFirst(), 30);

Assert.isTrue(d.isEmpty());

d.addFirst(1);
d.addLast(2);
d.addFirst(0);
d.addLast(3);

Assert.equals(d.size(), 4);
Assert.equals(d.peekFirst(), 0);
Assert.equals(d.peekLast(), 3);

d.clear();

d.addLast(5);
d.addLast(5);
d.addLast(5);

Assert.equals(d.size(), 3);

Assert.equals(d.removeLast(), 5);
Assert.equals(d.removeLast(), 5);
Assert.equals(d.removeLast(), 5);

Assert.isTrue(d.isEmpty());

d.addLast(10);
d.addLast("hello");
d.addLast(true);

Assert.equals(d.size(), 3);
Assert.equals(d.peekFirst(), 10);
Assert.equals(d.peekLast(), true);

d.clear();
Assert.isTrue(d.isEmpty());

d.addLast(100);
Assert.equals(d.peekLast(), 100);

println "-".repeat(50);

println "removeFirst test";

var d = new ArrayDeque();

// should throw when empty
try do
    d.removeFirst();
    Assert.fail("removeFirst on empty should throw");
end
catch(e) do
    Assert.isTrue(true);
end

// single element
d.addLast(10);

Assert.equals(d.removeFirst(), 10);
Assert.isTrue(d.isEmpty());

// multiple elements
d.addLast(1);
d.addLast(2);
d.addLast(3);

Assert.equals(d.removeFirst(), 1);
Assert.equals(d.peekFirst(), 2);
Assert.equals(d.size(), 2);

// order check
Assert.equals(d.removeFirst(), 2);
Assert.equals(d.removeFirst(), 3);

Assert.isTrue(d.isEmpty());

// mix with addFirst
d.addFirst(10);
d.addFirst(20);
d.addLast(30);

Assert.equals(d.removeFirst(), 20);
Assert.equals(d.removeFirst(), 10);
Assert.equals(d.removeFirst(), 30);

Assert.isTrue(d.isEmpty());

// duplicates
d.addLast(5);
d.addLast(5);
d.addLast(5);

Assert.equals(d.removeFirst(), 5);
Assert.equals(d.removeFirst(), 5);
Assert.equals(d.removeFirst(), 5);

Assert.isTrue(d.isEmpty());

// mixed types
d.addLast(10);
d.addLast("hello");
d.addLast(true);

Assert.equals(d.removeFirst(), 10);
Assert.equals(d.removeFirst(), "hello");
Assert.equals(d.removeFirst(), true);

Assert.isTrue(d.isEmpty());

println "-".repeat(50);

