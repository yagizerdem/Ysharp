println "arr.insert test cases started";

println "basic insert";
var arr = [1,2,3];
arr.insert(1, 99); // [1,99,2,3]

Assert.equals(arr.size(), 4);
Assert.equals(arr.get(1), 99);
Assert.equals(arr.get(2), 2);

println "-".repeat(50);

println "insert at beginning";
var arr = [1,2,3];
arr.insert(0, 42); // [42,1,2,3]

Assert.equals(arr.get(0), 42);
Assert.equals(arr.get(1), 1);

println "-".repeat(50);

println "insert at end (index == size)";
var arr = [1,2,3];
arr.insert(arr.size(), 77); // [1,2,3,77]

Assert.equals(arr.get(3), 77);

println "-".repeat(50);

println "shifting test";
var arr = [10,20,30,40];
arr.insert(2, 99); // [10,20,99,30,40]

Assert.equals(arr.get(2), 99);
Assert.equals(arr.get(3), 30);
Assert.equals(arr.get(4), 40);

println "-".repeat(50);

println "multiple inserts";
var arr = [];
arr.insert(0, 1);
arr.insert(1, 2);
arr.insert(1, 3); // [1,3,2]

Assert.equals(arr.get(0), 1);
Assert.equals(arr.get(1), 3);
Assert.equals(arr.get(2), 2);

println "-".repeat(50);

println "return value test (size)";
var arr = [1,2];
var result = arr.insert(1, 5);

Assert.equals(result, 3);
Assert.equals(arr.size(), 3);

println "-".repeat(50);

println "implicit number conversion (double index)";
var arr = [1,2,3];
arr.insert(1.0, 88);

Assert.equals(arr.get(1), 88);

println "-".repeat(50);

println "insert null";
var arr = [1,2];
arr.insert(1, null);

Assert.isNull(arr.get(1));

println "-".repeat(50);

println "invalid index (negative)";
try do
    var arr = [1,2,3];
    arr.insert(-1, 5);
    Assert.fail("negative index should throw");
end
catch(e) do
    Assert.isTrue(true);
end

println "-".repeat(50);

println "invalid index (too large)";
try do
    var arr = [1,2,3];
    arr.insert(10, 5);
    Assert.fail("index > size should throw");
end
catch(e) do
    Assert.isTrue(true);
end

println "-".repeat(50);

println "invalid type for index";
try do
    var arr = [1,2,3];
    arr.insert("a", 5);
    Assert.fail("non-number index should throw");
end
catch(e) do
    Assert.isTrue(true);
end

println "-".repeat(50);

println "stress insert at front (worst case shift)";
var arr = [];

for var i = 0; i < 1000; i++ do
    arr.insert(0, i);
end

println arr.toString();

Assert.equals(arr.size(), 1000);
Assert.equals(arr.get(0), 999);

println "-".repeat(50);

println "all arr.insert test cases successful";