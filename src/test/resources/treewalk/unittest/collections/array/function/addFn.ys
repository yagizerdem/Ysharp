println "arr.add extended test cases started";

// basic add
var arr = [];
arr.add(1);
arr.add(2);
arr.add(3);

Assert.equals(arr.size(), 3);
Assert.equals(arr.get(0), 1);
Assert.equals(arr.get(1), 2);
Assert.equals(arr.get(2), 3);


println "-".repeat(50);


println "add different types";
var mixed = [];
mixed.add(1);
mixed.add("hello");
mixed.add(true);

Assert.equals(mixed.size(), 3);
Assert.equals(mixed.get(1), "hello");
Assert.equals(mixed.get(2), true);


println "-".repeat(50);


println "add null";

var withNull = [];
withNull.add(null);

Assert.equals(withNull.size(), 1);
Assert.isNull(withNull.get(0));


println "-".repeat(50);


println "alias test (push)";


var aliasArr = [];
aliasArr.push(10);
aliasArr.push(20);

Assert.equals(aliasArr.size(), 2);
Assert.equals(aliasArr.get(0), 10);
Assert.equals(aliasArr.get(1), 20);


println "-".repeat(50);


println "chaining test (if supported)" ;

var chain = [];
chain.add(1);
chain.add(2);
chain.add(3);

Assert.equals(chain.size(), 3);


println "-".repeat(50);


println "large add test";
var big = [];
for var i = 0; i < 1000; i++ do
    big.add(i);
end

Assert.equals(big.size(), 1000);
Assert.equals(big.get(999), 999);


println "-".repeat(50);


println "add after clear";
var testClear = [];
testClear.add(1);
testClear.add(2);
testClear.clear();
testClear.add(42);

Assert.equals(testClear.size(), 1);
Assert.equals(testClear.get(0), 42);


println "-".repeat(50);


println "order preservation";
var order = [];
order.add(5);
order.add(1);
order.add(9);

Assert.equals(order.get(0), 5);
Assert.equals(order.get(1), 1);
Assert.equals(order.get(2), 9);


println "-".repeat(50);

println "interaction with remove";
var removeTest = [];
removeTest.add(1);
removeTest.add(2);
removeTest.add(3);

removeTest.remove(1); // remove 2
Assert.equals(removeTest.size(), 2);
Assert.equals(removeTest.get(1), 3);

println "add after remove";
removeTest.add(99);
Assert.equals(removeTest.get(2), 99);


println "-".repeat(50);


println "contains check after add";
var containsTest = [];
containsTest.add(7);

Assert.isTrue(containsTest.contains(7));
Assert.isFalse(containsTest.contains(8));


println "-".repeat(50);


println "mutation during iteration test";

var arr = [1, 2, 3];

for var i = 0; i < arr.size(); i++ do
    if i == 1 then do
        arr.add(99);
    end
end

Assert.isTrue(arr.size() >= 3);


println "-".repeat(50);


println "add inside forEach test";

var arr = [1,2,3];

arr.forEach((x, i, a) => do
    if x == 2 then do
        a.add(10);
    end
end);

Assert.isTrue(arr.contains(10));


println "-".repeat(50);


println "clone interaction test";

var arr = [];
arr.add(1);

var cloned = arr.clone();
cloned.add(2);

Assert.equals(arr.size(), 1);
Assert.equals(cloned.size(), 2);

println "-".repeat(50);


println "indexOf consistency";

var arr = [];
arr.add(5);
arr.add(5);

Assert.equals(arr.indexOf(5), 0);
Assert.equals(arr.lastIndexOf(5), 1);

println "-".repeat(50);

println "sort after add";

var arr = [];
arr.add(3);
arr.add(1);
arr.add(2);

arr.sort((a,b) => a - b);

Assert.equals(arr.get(0), 1);
Assert.equals(arr.get(1), 2);
Assert.equals(arr.get(2), 3);

println arr.toString();

println "-".repeat(50);

println "capacity stress";

var arr = [];

for var i = 0; i < 10000; i++ do
    arr.add(i);
end

Assert.equals(arr.get(9999), 9999);

println "-".repeat(50);


println "all arr.add extended test cases successful";