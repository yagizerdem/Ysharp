println "StringBuilder.length test cases started";

// empty length
var sb1 = new StringBuilder();
Assert.equals(sb1.length(), 0);

// after append
var sb2 = new StringBuilder();
sb2.append("abc");
Assert.equals(sb2.length(), 3);

// after multiple append
var sb3 = new StringBuilder();
sb3.append("a").append("bc").append("def");
Assert.equals(sb3.length(), 6);

// after appendLine (newline dahil!)
var sb4 = new StringBuilder();
sb4.appendLine("a");
Assert.equals(sb4.length(), 2); // "a\n"

// multiple appendLine
var sb5 = new StringBuilder();
sb5.appendLine("a");
sb5.appendLine("b");
Assert.equals(sb5.length(), 4); // "a\nb\n"

// after clear
var sb6 = new StringBuilder();
sb6.append("abc");
sb6.clear();
Assert.equals(sb6.length(), 0);

// after insert
var sb7 = new StringBuilder();
sb7.append("abc");
sb7.insert(1, "XYZ");
Assert.equals(sb7.length(), 6);

// unicode
var sb8 = new StringBuilder();
sb8.append("çalış");
Assert.equals(sb8.length(), 5);

// append number
var sb9 = new StringBuilder();
sb9.append(123);
Assert.equals(sb9.length(), 5); // "123.0"

// append null
var sb10 = new StringBuilder();
sb10.append(null);
Assert.equals(sb10.length(), 4); // "null"

// chaining
var sb11 = new StringBuilder();
sb11.append("a").append("b").append("c");
Assert.equals(sb11.length(), 3);

// after char array append
var sb12 = new StringBuilder();
sb12.append(['a','b','c'], 0, 3);
Assert.equals(sb12.length(), 3);

// after partial append
var sb13 = new StringBuilder();
sb13.append(['a','b','c'], 1, 2);
Assert.equals(sb13.length(), 2);

// after appendLine char array
var sb14 = new StringBuilder();
sb14.appendLine(['a','b'], 0, 2);
Assert.equals(sb14.length(), 4); // "a\nb\n"

// insert null
var sb15 = new StringBuilder();
sb15.insert(0, null);
Assert.equals(sb15.length(), 4);

println "length test cases successful";