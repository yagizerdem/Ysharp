println "StringBuilder.appendLine test cases started";

// basic string
var sb1 = new StringBuilder();
sb1.appendLine("hello");
Assert.equals(sb1.toString(), "hello\n");

// chaining
var sb2 = new StringBuilder();
sb2.appendLine("a").appendLine("b").appendLine("c");
Assert.equals(sb2.toString(), "a\nb\nc\n");

// append number
var sb3 = new StringBuilder();
sb3.appendLine(123);
Assert.equals(sb3.toString(), "123.0\n");

// append boolean
var sb4 = new StringBuilder();
sb4.appendLine(true);
Assert.equals(sb4.toString(), "true\n");

// append char
var sb5 = new StringBuilder();
sb5.appendLine('A');
Assert.equals(sb5.toString(), "A\n");

// append null
var sb6 = new StringBuilder();
sb6.appendLine(null);
Assert.equals(sb6.toString(), "null\n");

// multiple appendLine calls
var sb7 = new StringBuilder();
sb7.appendLine("x");
sb7.appendLine("y");
sb7.appendLine("z");
Assert.equals(sb7.toString(), "x\ny\nz\n");

// mixed append + appendLine
var sb8 = new StringBuilder();
sb8.append("start-");
sb8.appendLine("line1");
sb8.append("mid-");
sb8.appendLine("line2");
Assert.equals(sb8.toString(), "start-line1\nmid-line2\n");

// empty string
var sb9 = new StringBuilder();
sb9.appendLine("");
Assert.equals(sb9.toString(), "\n");

// unicode
var sb10 = new StringBuilder();
sb10.appendLine("çalış");
Assert.equals(sb10.toString(), "çalış\n");


// basic char array
var sb11 = new StringBuilder();
sb11.appendLine(['a','b','c'], 0, 3);
Assert.equals(sb11.toString(), "a\nb\nc\n");

// partial array
var sb12 = new StringBuilder();
sb12.appendLine(['a','b','c','d'], 1, 2);
Assert.equals(sb12.toString(), "b\nc\n");

// appendLine twice with arrays
var sb13 = new StringBuilder();
sb13.appendLine(['x','y'], 0, 2);
sb13.appendLine(['a','b'], 0, 2);
Assert.equals(sb13.toString(), "x\ny\na\nb\n");

// offset = 0, len = 0
var sb14 = new StringBuilder();
sb14.appendLine(['a','b','c'], 0, 0);
Assert.equals(sb14.toString(), "");

// offset at end
var sb15 = new StringBuilder();
sb15.appendLine(['a','b','c'], 3, 0);
Assert.equals(sb15.toString(), "");


// appendLine after append
var sb16 = new StringBuilder();
sb16.append("abc");
sb16.appendLine("X");
Assert.equals(sb16.toString(), "abcX\n");

// multiple newline accumulation
var sb17 = new StringBuilder();
sb17.appendLine("a");
sb17.appendLine("");
sb17.appendLine("b");
Assert.equals(sb17.toString(), "a\n\nb\n");

// non-array
var sb18 = new StringBuilder();
try do
    sb18.appendLine("abc", 0, 1);
    Assert.fail("Expected array error");
end
catch(e) do
    Assert.isTrue(true);
end

// non-char array
var sb19 = new StringBuilder();
try do
    sb19.appendLine([1,2,3], 0, 3);
    Assert.fail("Expected char array error");
end
catch(e) do
    Assert.isTrue(true);
end

// invalid offset/len
var sb20 = new StringBuilder();
try do
    sb20.appendLine(['a','b'], 1, 5);
    Assert.fail("Expected invalid offset/length");
end
catch(e) do
    Assert.isTrue(true);
end

println "all appendLine test cases successful";