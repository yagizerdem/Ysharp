println "StringBuilder.clear test cases started";

// basic clear
var sb1 = new StringBuilder();
sb1.append("hello");
sb1.clear();
Assert.equals(sb1.toString(), "");

// clear empty
var sb2 = new StringBuilder();
sb2.clear();
Assert.equals(sb2.toString(), "");

// clear after multiple appends
var sb3 = new StringBuilder();
sb3.append("a").append("b").append("c");
sb3.clear();
Assert.equals(sb3.toString(), "");

// clear after appendLine
var sb4 = new StringBuilder();
sb4.appendLine("test");
sb4.clear();
Assert.equals(sb4.toString(), "");

// chaining after clear
var sb5 = new StringBuilder();
sb5.append("abc");
sb5.clear().append("x");
Assert.equals(sb5.toString(), "x");

// multiple clear calls
var sb6 = new StringBuilder();
sb6.append("abc");
sb6.clear();
sb6.clear();
Assert.equals(sb6.toString(), "");

// clear should not break object
var sb7 = new StringBuilder();
sb7.append("data");
var ref = sb7;
sb7.clear();
Assert.equals(ref.toString(), "");

// clear + reuse
var sb8 = new StringBuilder();
sb8.append("hello");
sb8.clear();
sb8.append("world");
Assert.equals(sb8.toString(), "world");

println "clear test cases successful";