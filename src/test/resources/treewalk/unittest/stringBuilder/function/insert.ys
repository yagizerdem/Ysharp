println "StringBuilder.insert test cases started";

// basic insert string
var sb1 = new StringBuilder();
sb1.append("yagiz");
sb1.insert(1, "X");
Assert.equals(sb1.toString(), "yXagiz");



// insert at beginning
var sb2 = new StringBuilder();
sb2.append("hello");
sb2.insert(0, "A");
Assert.equals(sb2.toString(), "Ahello");



// insert at end
var sb3 = new StringBuilder();
sb3.append("test");
sb3.insert(sb3.length(), "!");
Assert.equals(sb3.toString(), "test!");



// insert number
var sb4 = new StringBuilder();
sb4.append("value=");
sb4.insert(6, 123);
Assert.equals(sb4.toString(), "value=123");



// insert boolean
var sb5 = new StringBuilder();
sb5.append("flag:");
sb5.insert(5, true);
Assert.equals(sb5.toString(), "flag:true");



// insert char array (full)
var sb6 = new StringBuilder();
sb6.append("abc");
sb6.insert(1, ['x','y','z']);
println sb6.toString();
Assert.equals(sb6.toString(), "axyzbc");


// insert char array with offset/len
var sb7 = new StringBuilder();
sb7.append("hello");
sb7.insert(1, ['a','b','c','d'], 1, 2);
Assert.equals(sb7.toString(), "hbcello");



// insert middle complex
var sb8 = new StringBuilder();
sb8.append("12345");
sb8.insert(2, ['x','y','z'], 0, 3);
Assert.equals(sb8.toString(), "12xyz345");



// chaining
var sb9 = new StringBuilder();
sb9.append("abc")
   .insert(1, "X")
   .insert(2, "Y");
Assert.equals(sb9.toString(), "aXYbc");


// mutability check
var sb10 = new StringBuilder();
sb10.append("test");
var ref = sb10;
sb10.insert(1, "X");
Assert.equals(ref.toString(), "tXest");

// index out of bounds
var sb11 = new StringBuilder();
sb11.append("abc");
try do
    sb11.insert(10, "x");
    Assert.fail("Expected exception for index out of bounds");
end
catch(e) do
    Assert.isTrue(true);
end

// negative index
var sb12 = new StringBuilder();
sb12.append("abc");
try do
    sb12.insert(-1, "x");
    Assert.fail("Expected exception for negative index");
end
catch(e) do
    Assert.isTrue(true);
end

// invalid offset/len
var sb13 = new StringBuilder();
sb13.append("abc");
try do
    sb13.insert(1, ['a','b'], 1, 5);
    Assert.fail("Expected invalid offset/length");
end
catch(e) do
    Assert.isTrue(true);
end

// non-char array
var sb14 = new StringBuilder();
sb14.append("abc");
try do
    sb14.insert(1, [1,2,3], 0, 3);
    Assert.fail("Expected char array error");
end
catch(e) do
    Assert.isTrue(true);
end

try do
    // empty insert
    var sb15 = new StringBuilder();
    sb15.append("abc");
    sb15.insert(1, "", 0, 0);
    Assert.equals(sb15.toString(), "abc");
end
catch(e) do
    Assert.isTrue(true);
end



// insert null
var sb16 = new StringBuilder();
sb16.append("abc");
sb16.insert(1, null);
Assert.equals(sb16.toString(), "anullbc");

println "all insert test cases successful";


println "additional StringBuilder.insert edge tests started";

// insert empty string
var sb17 = new StringBuilder();
sb17.append("abc");
sb17.insert(1, "");
Assert.equals(sb17.toString(), "abc");

// insert multiple times same index (order check)
var sb18 = new StringBuilder();
sb18.append("abc");
sb18.insert(1, "X");
sb18.insert(1, "Y");
Assert.equals(sb18.toString(), "aYXbc");

// insert unicode
var sb19 = new StringBuilder();
sb19.append("abc");
sb19.insert(1, "ç");
Assert.equals(sb19.toString(), "açbc");

// insert char array single element
var sb20 = new StringBuilder();
sb20.append("abc");
sb20.insert(2, ['Z']);
Assert.equals(sb20.toString(), "abZc");

// insert char array empty
var sb21 = new StringBuilder();
sb21.append("abc");
sb21.insert(1, []);
Assert.equals(sb21.toString(), "abc");



// insert with offset = 0, len = 0
var sb22 = new StringBuilder();
sb22.append("abc");
sb22.insert(1, ['a','b','c'], 0, 0);
Assert.equals(sb22.toString(), "abc");


// insert with offset at end boundary
var sb23 = new StringBuilder();
sb23.append("abc");
sb23.insert(1, ['x','y','z'], 3, 0);
Assert.equals(sb23.toString(), "abc");



// insert large chain
var sb24 = new StringBuilder();
sb24.append("a");
for var i = 0; i < 5; i++ do
    sb24.insert(1, i);
end
Assert.equals(sb24.toString(), "a43210");

// insert self content (critical)
var sb25 = new StringBuilder();
sb25.append("abc");
var str = sb25.toString();
sb25.insert(1, str);
Assert.equals(sb25.toString(), "aabcbc");

// insert with index == length repeatedly
var sb26 = new StringBuilder();
sb26.append("a");
sb26.insert(1, "b");
sb26.insert(2, "c");
Assert.equals(sb26.toString(), "abc");

// insert invalid type (object)
var sb27 = new StringBuilder();
sb27.append("abc");
try do
    sb27.insert(1, {"a":1});
    Assert.fail("Expected error for invalid object insert");
end
catch(e) do
    Assert.isTrue(true);
end

// insert null into empty builder
var sb28 = new StringBuilder();
sb28.insert(0, null);
Assert.equals(sb28.toString(), "null");

// insert char array partial reverse scenario
var sb29 = new StringBuilder();
sb29.append("abc");
sb29.insert(1, ['x','y','z'], 1, 2); // y,z
Assert.equals(sb29.toString(), "ayzbc");

// insert into empty builder
var sb30 = new StringBuilder();
sb30.insert(0, "hello");
Assert.equals(sb30.toString(), "hello");

println "additional tests successful";




