const terminal = new TUI.DefaultTerminal();

terminal.autoFlush = true;

terminal.enableSgr(TUI.SGR.UNDERLINE);
terminal.enableSgr(TUI.SGR.BOLD);

for var i = 0 ; i < 10 ; i++ do
    if i > 5 then do
        terminal.disableSgr(TUI.SGR.BOLD);
    end
    // terminal.setCursorPosition(0,i);
    terminal.write("yagiz erdem");
end


var keyPress = TUI.KeyStroke.fromChar('a', false, true);
println keyPress.getCharacter();
println keyPress.isAltDown();
println keyPress.isCtrlDown();
println keyPress.hashCode();


var a = 10;

switch a do

    case 2 : do
        print "hit case 2";
    end

    case 10 : do
        print "hit case 10";
        break;
    end

    case 11 : do
        println "hit case  11";
    end

    default : do
        print "default";
    end
end

Time.sleep(2000);
terminal.close();

