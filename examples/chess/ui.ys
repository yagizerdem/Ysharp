use "piece.ys";
use "board.ys";
use "sd.ys";

export const terminal = new TUI.YPFTerminal();


export function printBoard(board : Board) do
    for var row in 0..7 do
        for var col in 0..7 do
            const p = board.arena.get(row).get(col);
            if p != null then do
                // adjust color here

                if p.isRed() then do
                    terminal.setForegroundColor(TUI.TextColor.ANSI.BRIGHT_RED);
                end
                else do
                    terminal.setForegroundColor(TUI.TextColor.ANSI.BRIGHT_BLUE);
                end

                if row == selectedRow && col == selectedCol then do
                    terminal.setForegroundColor(TUI.TextColor.ANSI.GREEN);
                end

                terminal.setCursorPosition(col * 3, row);
                terminal.putCharacter(Type.Converter.toChar(p.printType()));

                terminal.setForegroundColor(TUI.TextColor.ANSI.WHITE);
            end
            else do
                terminal.setCursorPosition(col * 3, row);
                terminal.putCharacter('.');
            end

        end
    end
    terminal.setCursorPosition(25, 2);
    terminal.writeLine("use wasd keys to navigate");
    terminal.setCursorPosition(25, 3);
    terminal.writeLine("use e key to select and move piece");
    terminal.flush();
end

export function printPanel(cy : int) do
    terminal.clearScreen();
    terminal.writeLine("-".repeat(40));
    terminal.writeLine("| " +  " ".repeat(38) + "|");
    terminal.writeLine("| " +  " ".repeat(38) + "|");
    terminal.writeLine("| " +  " ".repeat(38) + "|");
    terminal.writeLine("| " +  " ".repeat(38) + "|");
    terminal.writeLine("| " +  " ".repeat(38) + "|");
    terminal.writeLine("| " +  " ".repeat(38) + "|");
    terminal.writeLine("-".repeat(40));
    terminal.writeLine("");
    terminal.writeLine("press w key to navigate upward");
    terminal.writeLine("press s key to navigate downward");
    terminal.writeLine("press e key to navigate select mode");

    terminal.setCursorPosition(7, 2);
    terminal.writeLine("Normal");
    terminal.setCursorPosition(7, 3);
    terminal.writeLine("Random");
    terminal.setCursorPosition(7, 4);
    terminal.writeLine("AI depth 2");
    terminal.setCursorPosition(7, 5);
    terminal.writeLine("AI depth 3");

    terminal.setCursorPosition(2, cy);
    terminal.setForegroundColor(TUI.TextColor.ANSI.BRIGHT_RED);
    terminal.write("> ");
    terminal.setForegroundColor(TUI.TextColor.ANSI.WHITE);
    terminal.flush();
end
