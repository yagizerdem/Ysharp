use "board.ys";
use "ui.ys";
use "piece.ys";
use "sd.ys";
use "engine.ys";
use "ai.ys";

class GameMode {
    static const HUMAN = 0;
    static const RANDOM = 1;
    static const AI = 2;
}

var mode = GameMode.HUMAN;

var level = 2;
printPanel(level);
while true do
    var userKey = terminal.readKey();

    if userKey != null && userKey.getCharacter() == 'w' then do
        level--;
        level = __int(Math.clamp(level, 2, 5));
        printPanel(level);
    end
    if userKey != null && userKey.getCharacter() == 's' then do
        level++;
        level = __int(Math.clamp(level, 2, 5));
        printPanel(level);
    end
    if userKey != null && userKey.getCharacter() == 'e' then do
        if level == 2 then do mode = GameMode.HUMAN; end
        if level == 3 then do mode = GameMode.RANDOM; end
        if level == 4 then do mode = GameMode.AI; MAX_DEPTH = 2; end
        if level == 5 then do mode = GameMode.AI; MAX_DEPTH = 3; end
        break;
    end

end

terminal.clearScreen();

board.init();

printBoard(board); // inital render of board
// re-render only if board state changes

let shouldMove : bool = false;


while true do
    // sync cursor poisiton
    terminal.setCursorPosition(cx, cy);
    terminal.flush();
    var userKey = terminal.pollKey();

    if userKey != null && userKey.getCharacter() == 'a' then do
        cx-=3;
        cx = Type.Converter.toInt(Math.clamp(cx, 0, 21));
    end
    elif userKey != null && userKey.getCharacter() == 'd' then do
        cx+=3;
        cx = Type.Converter.toInt(Math.clamp(cx, 0, 21));
    end
    elif userKey != null && userKey.getCharacter() == 'w' then do
        cy--;
        cy = Type.Converter.toInt(Math.clamp(cy, 0, 7));
    end
    elif userKey != null && userKey.getCharacter() == 's' then do
        cy++;
        cy = Type.Converter.toInt(Math.clamp(cy, 0, 7));
    end
    elif userKey != null && userKey.getCharacter() == 'e' then do
        // corresponding row and col of cursor
        const row = cy;
        const col = cx / 3;

        // user selects a piece
        if
            board.containsPiece(row, col) &&
            playerColor == board.getPiece(row, col).color
         then do
            selectedRow = row;
            selectedCol = col;
            // re render the board to display selected piece color change
            printBoard(board);
        end
        elif  selectedRow != null then do
            toRow = row;
            toCol = col;
            shouldMove = true;
        end

    end

    if shouldMove then do
        // execute engine to check valid move or not

        if checkMoveIsValid([selectedRow, selectedCol], [toRow, toCol], board) then do
            if mode == GameMode.HUMAN then do
                movePiece([selectedRow, selectedCol], [toRow, toCol], board);
                playerColor =  playerColor == Piece.RED ? Piece.BLUE : Piece.RED;
            end
            elif mode == GameMode.RANDOM then do
                movePiece([selectedRow, selectedCol], [toRow, toCol], board);

                const moves = generateAllValidMoves(board, playerColor == Piece.RED ? Piece.BLUE : Piece.RED);
                const random_move = moves.get(Random.nextInt(0, moves.size()));
                movePiece(random_move.get(0), random_move.get(1), board);
            end
            elif mode == GameMode.AI then do
                movePiece([selectedRow, selectedCol], [toRow, toCol], board);
                printBoard(board);
                terminal.setCursorPosition(25, 6);
                terminal.writeLine("AI is thinking...");
                terminal.setCursorPosition(cx, cy);
                terminal.flush();


                const bestMove = findBestMove(board, playerColor == Piece.RED ? Piece.BLUE : Piece.RED);
                if bestMove != null then do
                    movePiece(bestMove.get(0), bestMove.get(1), board);
                end
                terminal.setCursorPosition(25, 6);
                terminal.writeLine(" ".repeat(20));
                terminal.setCursorPosition(cx, cy);
                terminal.flush();
            end
        end
        shouldMove = false;
        selectedRow = null;
        selectedCol = null;
        printBoard(board);

    end


    terminal.clearInputBuffer();
    __sleep(50);

end
